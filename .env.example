# The Devil's Advocate - API Keys Configuration
# Copy this file to .env and add your actual API keys

# =============================================================================
# REQUIRED: At least ONE AI provider key is needed
# =============================================================================

# OpenAI API Key (for GPT-4, GPT-5 models)
# Get it from: https://platform.openai.com/api-keys
# Cost: ~.50-1.00 per analysis
OPENAI_API_KEY=

# Anthropic API Key (for Claude models)
# Get it from: https://console.anthropic.com/settings/keys
# Cost: ~.30-0.80 per analysis
ANTHROPIC_API_KEY=

# Google API Key (for Gemini models)
# Get it from: https://aistudio.google.com/app/apikey
# Cost: ~.20-0.50 per analysis (often free tier)
GOOGLE_API_KEY=

# =============================================================================
# OPTIONAL: Competitor Intelligence
# =============================================================================

# Serper API Key (for competitor intelligence gathering)
# Get it from: https://serper.dev
# Free tier: 2,500 searches/month
# Required only if you want to use 'Include Competitor Intel' feature
SERPER_API_KEY=

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 
# 1. NEVER commit the .env file to git
# 2. NEVER share your .env file with anyone
# 3. Each user should create their own .env file with their own keys
# 4. If you accidentally expose a key, revoke it immediately and generate a new one
# 5. Keep this file in your project root directory
#
